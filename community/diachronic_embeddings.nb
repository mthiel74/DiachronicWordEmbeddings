 RowBox[{"deDriftChart", "[", "25", "]"}]], "Input",
 CellMargins->{{50, 30}, {8, 8}},
 FontSize->12,ExpressionUUID->"8f269a91-7942-4d15-84f4-195ba0cd7d24"],

