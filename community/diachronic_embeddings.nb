Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 StyleBox["web",
  FontSlant->Italic],
 " runs from the spider's ",
 StyleBox["threads, woven, weave, mesh",
  FontSlant->Italic],
 " to the ",
 StyleBox["www, url, html, browser, server, internet",
  FontSlant->Italic],
 " of the 1990s."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"3858ee37-309c-4f9f-b265-5986e5b1d77c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. The full gallery", "Section",ExpressionUUID->"106b4af0-9f91-48e4-8738-cbbdfdb7a0dd"],

Cell[TextData[{
 "The same construction for all fourteen words. Alongside those above: ",
 StyleBox["awful",
  FontSlant->Italic],
 " (awe \[Rule] very bad), ",
 StyleBox["queer",
  FontSlant->Italic],
 " (odd \[Rule] LGBTQ), ",
 StyleBox["literally",
  FontSlant->Italic],
 " (exactly \[Rule] intensifier), ",
 StyleBox["fun",
  FontSlant->Italic],
 " (jest/mischief \[Rule] enjoyment), ",
 StyleBox["cell",
  FontSlant->Italic],
 " (prison \[Rule] biology \[Rule] battery) and ",
 StyleBox["nice",
  FontSlant->Italic],
 " (fastidious \[Rule] pleasant)."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"dc18b6e5-8e90-499a-b12f-b2447e37db96"],

