Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 "The 25 most-drifted stable content words, 1800s\[Dash]1990s. Full ",
 "ranking in ",
 StyleBox["data/drift_ranking.json",
  FontFamily->"Courier"],
 "."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"34ccb716-e00b-4252-9727-76fbc449e65f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. How to reproduce", "Section",ExpressionUUID->"67fa0d19-f8ef-4c7c-909f-83c68faff677"],

Cell["\<\
The pipeline is four steps; the science is pure Wolfram Language and the only \
Python is a format shim for the NumPy/pickle files.\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"6d061690-9cae-4401-9ccf-d447f83cf05b"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/fetch_data.wls",
  FontFamily->"Courier"],
 "  \[Dash] download + unzip the HistWords eng-all SGNS embeddings"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"b939c2e2-b40f-4f35-8826-595e49f4bcd7"],

Cell[TextData[{
 StyleBox["python3 src/convert_histwords.py",
  FontFamily->"Courier"],
 "  \[Dash] .npy/.pkl \[Rule] float32 binaries + vocab"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"614f0aab-fea0-4e9d-a7be-505f7f8ec188"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/trajectories.wls",
  FontFamily->"Courier"],
 "  \[Dash] align, project, render the trajectory figures + JSON"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"43ab6b9e-693c-422c-9b55-a285c26e3022"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/laws_and_drift.wls",
  FontFamily->"Courier"],
 "  \[Dash] the laws of change and the drift leaderboard"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"718e21b0-6514-4888-a7ec-525381d5e370"],

Cell[TextData[{
 "Repository: ",
 StyleBox["github.com/mthiel74/DiachronicWordEmbeddings",
  FontFamily->"Courier"],
 ". Derived data products (neighbour tables, trajectory coordinates, drift \
ranking) ",
 "are committed as small JSON files; the 1.6 GB raw download is regenerable."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"93eff1da-4d0d-40b7-9f45-f1f655855e0f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. References", "Section",ExpressionUUID->"f2b4f49a-aae7-43cf-bc03-4c188e72d5ec"],

Cell[TextData[{
 "W. L. Hamilton, J. Leskovec, D. Jurafsky (2016). ",
 StyleBox["Diachronic Word Embeddings Reveal Statistical Laws of Semantic \
Change.",
  FontSlant->Italic],
 " ACL 2016. arXiv:1605.09096."
}], "Text",
 CellMargins->{{60, 50}, {3, 3}},
 FontSize->11,ExpressionUUID->"404340c3-4b80-4d4c-9cc7-1b5cfa97e7c2"]
}, Open  ]]
