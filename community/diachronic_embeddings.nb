Cell[CellGroupData[{
Cell["Diachronic Word Embeddings", "Title",ExpressionUUID->"ef5ddfe4-5a0b-4298-b103-f4ebb42510e5"],

Cell["\<\
200 Years of Semantic Drift, Traced Through a Word-Embedding Space\
\>", "Subtitle",ExpressionUUID->"647d7af3-83f0-4177-9393-67a752dd6712"],

Cell[TextData[{
 StyleBox["Marco Thiel",
  FontSlant->Italic],
 "   \[Bullet]   ",
 StyleBox["github.com/mthiel74/DiachronicWordEmbeddings",
  FontFamily->"Courier"]
}], "Text",
 CellMargins->{{50, 50}, {4, 10}},
 FontSize->12,
 FontColor->GrayLevel[
  0.45],ExpressionUUID->"660a71f9-0723-48be-b863-c4f4e8f06394"],

Cell[CellGroupData[{

Cell["Setup", "Section",ExpressionUUID->"a98d44f8-05d4-4110-88eb-783f24c5e7cd"],

Cell[TextData[{
 "This notebook needs exactly one companion file: the package ",
 StyleBox["DiachronicEmbeddings.wl",
  FontFamily->"Courier"],
 ", which holds all of the code ",
 StyleBox["and",
  FontSlant->Italic],
 " the small derived data it draws on (so no separate downloads, and not the ",
 "1.6 GB of raw HistWords embeddings). Put that file in the ",
 StyleBox["same folder",
  FontWeight->Bold],
 " as this notebook, then evaluate the cell below; every figure and table \
further ",
 "down is then a single call to one of the package's functions."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"d52271bc-d8d6-4862-9ede-28cf8487b58d"],

