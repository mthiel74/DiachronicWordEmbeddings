Cell[CellGroupData[{

Cell["9. Methods and reproduction", "Section",ExpressionUUID->"ca6d4f8d-1f18-494d-b154-e3507d44ba9f"],

Cell[TextData[{
 "Every output above is a single call to a function in the companion package ",
 StyleBox["DiachronicEmbeddings.wl",
  FontFamily->"Courier"],
 " attached alongside this notebook. That one file is ",
 "self-contained: it carries both the code and the small derived data \
products it draws ",
 "on, so the notebook runs from just the two uploaded files. (In the source \
repository ",
 "the same code lives un-bundled as ",
 StyleBox["wolfram/DiachronicEmbeddings.wl",
  FontFamily->"Courier"],
 " with the data split out under ",
 StyleBox["data/",
  FontFamily->"Courier"],
 "; ",
 StyleBox["community/bundle_package.wls",
  FontFamily->"Courier"],
 " is what folds the two together into the uploadable file.) To regenerate \
the data ",
 "products from scratch (the science is pure Wolfram Language; the only \
Python is a ",
 "NumPy/pickle format shim):"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"b2cda88d-7773-4132-b677-6eedc297a26e"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/fetch_data.wls",
  FontFamily->"Courier"],
 "  \[Dash] download + unzip the HistWords eng-all SGNS embeddings"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"6773c4a5-4902-40e3-9ae7-53b02fad3829"],

Cell[TextData[{
 StyleBox["python3 src/convert_histwords.py",
  FontFamily->"Courier"],
 "  \[Dash] .npy/.pkl \[Rule] float32 binaries + vocab (anchors, targets, \
pools)"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"462e3dc6-33d5-405d-a336-4b8a8844b85d"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/trajectories.wls",
  FontFamily->"Courier"],
 "  \[Dash] Procrustes alignment, projection \[Rule] trajectories.json + \
neighbors.json"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"5df77a87-0880-4f2f-9838-77e735e4abbf"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/laws_and_drift.wls",
  FontFamily->"Courier"],
 "  \[Dash] drift leaderboard + the two laws \[Rule] laws.json, \
laws_points.json, drift_ranking.json"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"0420e2bf-9daf-4883-97b5-81a11e1bd41d"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/alignment.wls",
  FontFamily->"Courier"],
 "  \[Dash] the alignment diagnostic \[Rule] alignment.json"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"d19d7627-2a0b-44ab-82e9-ed2bef725bd3"],

Cell[TextData[{
 "Repository: ",
 StyleBox["github.com/mthiel74/DiachronicWordEmbeddings",
  FontFamily->"Courier"],
 "."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"96f4c200-1255-45f8-a386-dbf49aed43a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Data, licensing, and acknowledgements", "Section",ExpressionUUID->"4760e85b-1031-43ec-ac81-84174fce3f4c"],

Cell[TextData[{
 "This notebook builds entirely on freely-reusable data, and redistributes ",
 "only small ",
 StyleBox["derived",
  FontSlant->Italic],
 " products of it \[Dash] 2-D trajectory coordinates, ",
 "nearest-neighbour word lists, and the alignment and law statistics."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"adbc177c-a22c-481e-9f88-9073b0485442"],

Cell[TextData[{
 StyleBox["HistWords embeddings. ",
  FontWeight->Bold],
 "The per-decade SGNS vectors are from the HistWords project (Hamilton, \
Leskovec & ",
 "Jurafsky), released into the ",
 StyleBox["public domain",
  FontWeight->Bold],
 " under the Open Data Commons ",
 "Public Domain Dedication and License (PDDL) v1.0. Redistribution of the \
embeddings and ",
 "of products derived from them is therefore unrestricted; as the project \
requests, the ",
 "source paper is cited below."
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"dc068433-3c00-4bef-968e-87f6b23c1eb6"],

Cell[TextData[{
 StyleBox["Google Books N-grams. ",
  FontWeight->Bold],
 "Those embeddings were trained on the Google Books Ngram ",
 StyleBox["eng-all",
  FontFamily->"Courier"],
 " corpus, released by Google under the ",
 StyleBox["Creative Commons Attribution 3.0",
  FontWeight->Bold],
 " (CC BY 3.0) licence (Google Books Ngram Viewer, ",
 StyleBox["books.google.com/ngrams",
  FontFamily->"Courier"],
 ")."
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"48b521c3-f861-4168-a8da-f890ca384b37"],

Cell[TextData[{
 StyleBox["WordNet. ",
  FontWeight->Bold],
 "The polysemy measure in \[Section]7 uses WordNet sense ",
 "counts via ",
 StyleBox["WordData",
  FontFamily->"Courier"],
 ". WordNet is \[Copyright] Princeton University, ",
 "made available under a permissive free licence (attribution)."
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"7b33f8a3-8fd8-46dc-8a91-d3c4af23c6a4"],

Cell[TextData[{
 StyleBox["This notebook's code. ",
  FontWeight->Bold],
 "The package ",
 StyleBox["DiachronicEmbeddings.wl",
  FontFamily->"Courier"],
 " and the rest of the companion ",
 "repository are released into the ",
 StyleBox["public domain (The Unlicense)",
  FontWeight->Bold],
 " \[Dash] reuse, modify, or sell freely, with no conditions and no \
attribution ",
 "required. No HistWords source code is redistributed here \[Dash] only the \
public-",
 "domain data products \[Dash] so the HistWords tools' Apache-2.0 licence \
does not apply."
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"3682ee23-eac1-4906-8fb5-8cb6d9854741"],

Cell["\<\
In short: the data carries no copyright restriction, the corpus and WordNet \
ask only for attribution (given here), and the code is MIT. The post is free \
to read, run, and build on.\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"490e940f-be1a-4ec3-958b-ea97b9be1b63"]
}, Open  ]],

