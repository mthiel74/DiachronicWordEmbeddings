   0.4426481721664387}, {-0.38041240190457776`, 
   0.640983823235024}}]], "Output",
 CellMargins->{{50, 30}, {8, 14}},
 ShowCellLabel->False,ExpressionUUID->"c5031f76-0b1c-4aa2-baa2-c773a0db72d7"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 StyleBox["gay",
  FontSlant->Italic],
 ": the path lingers among ",
 StyleBox["merry, cheerful, joyous, lively, gaiety",
  FontSlant->Italic],
 " through the blue and purple decades, ",
 "then swings sharply red-ward to ",
 StyleBox["homosexual, lesbian, gays, bisexual",
  FontSlant->Italic],
 " by the 1990s \[Dash] a two-century meaning change rendered as a single \
sweep."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"c4679fd1-6dcd-4990-b451-466750ca7454"],

Cell[TextData[{
 StyleBox["What the projection does and does not say.",
  FontWeight->Bold],
 " The 2-D layout is a ",
 StyleBox["per-word",
  FontSlant->Italic],
 " PCA of that word's own cloud, chosen to spread its motion across ",
 "the page; absolute positions and the axes themselves carry no global \
meaning, and 2-D ",
 "distances are an approximation of the true 300-D ones. The trustworthy \
signal is ",
 StyleBox["which neighbours sit at each end",
  FontWeight->Bold],
 " of the path and ",
 StyleBox["how far the word travels between them",
  FontWeight->Bold],
 " \[Dash] both of which come straight ",
 "from the high-dimensional cosine geometry, not the projection."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"4ce38b10-97d7-4bdd-b590-600ba40e847e"],

Cell[TextData[{
 StyleBox["Takeaway.  ",
  FontWeight->Bold],
 "Read a trajectory by its ",
 StyleBox["endpoints and their neighbours",
  FontSlant->Italic],
 ", not by the exact shape of the curve. The neighbours are the evidence; the \
curve is ",
 "just their geometry."
}], "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellMargins->{{60, 60}, {8, 12}},
 CellFrameColor->RGBColor[0.35, 0.6, 0.4],
 FontSize->12,
 Background->RGBColor[
  0.93, 0.97, 0.93],ExpressionUUID->"43314bd5-2d0f-411c-ae2a-bf39fb1b8c96"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Explore all fourteen words", "Section",ExpressionUUID->"e8250402-92a0-484c-bf17-df509a72dda8"],

Cell[TextData[{
 "Rather than print fourteen separate plots, the same construction is wired \
",
 "into one interactive ",
 StyleBox["Manipulate",
  FontFamily->"Courier"],
 ". Pick a word, scrub the time slider to ",
 "reveal the path decade by decade, and toggle the neighbour labels. (Opened \
in the ",
 "Wolfram notebook the controls are live immediately \[Dash] no need to \
re-evaluate; a ",
 "static export such as the PDF shows a single frame, ",
 StyleBox["gay",
  FontSlant->Italic],
 " with its full path.)"
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"7a75fdf8-61d2-4576-b5cc-6d966b1e5e4a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"deExplorer", "[", "]"}]], "Input",
 CellMargins->{{50, 30}, {8, 8}},
 FontSize->12,ExpressionUUID->"18a2829d-2346-400f-994d-314fb85c3720"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{DiachronicEmbeddings`Private`neighbourLabels$$ = True, 
    DiachronicEmbeddings`Private`word$$ = "gay", 
    DiachronicEmbeddings`Private`yearMax$$ = 1990, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[DiachronicEmbeddings`Private`word$$], "gay", "word"}, {
      "gay", "broadcast", "computer", "awful", "queer", "literally", 
       "terrific", "guy", "media", "fun", "cell", "nice", "mouse", "web"}, 
      ControlType -> PopupMenu}, {{
       Hold[DiachronicEmbeddings`Private`yearMax$$], 1990, 
       "reveal decades up to"}, 1800, 1990, 10, ControlType -> Manipulator}, {{
       Hold[DiachronicEmbeddings`Private`neighbourLabels$$], True, 
       "neighbour labels"}, {True, False}, ControlType -> Checkbox}}, 
    Typeset`size$$ = Automatic, Typeset`update$$ = 0, Typeset`initDone$$, 
    Typeset`skipInitDone$$ = False, Typeset`keyframeActionsQ$$ = False, 
    Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {
       DiachronicEmbeddings`Private`neighbourLabels$$ = True, 
        DiachronicEmbeddings`Private`word$$ = "gay", 
        DiachronicEmbeddings`Private`yearMax$$ = 1990}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      DiachronicEmbeddings`deTrajectoryPlot[
       DiachronicEmbeddings`Private`word$$, 
        DiachronicEmbeddings`Private`yearMax$$, 
        DiachronicEmbeddings`Private`neighbourLabels$$], 
      "Specifications" :> {{{
         DiachronicEmbeddings`Private`word$$, "gay", "word"}, {
         "gay", "broadcast", "computer", "awful", "queer", "literally", 
          "terrific", "guy", "media", "fun", "cell", "nice", "mouse", 
          "web"}}, {{
         DiachronicEmbeddings`Private`yearMax$$, 1990, 
          "reveal decades up to"}, 1800, 1990, 10, Appearance -> 
         "Labeled"}, {{
         DiachronicEmbeddings`Private`neighbourLabels$$, True, 
          "neighbour labels"}, {True, False}}}, 
      "Options" :> {ControlPlacement -> Top}, "DefaultOptions" :> {}],
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({DiachronicEmbeddings`deTrajectoryPlot[
         Pattern[DiachronicEmbeddings`Private`w, 
          Blank[String]]] := 
       DiachronicEmbeddings`deTrajectoryPlot[
        DiachronicEmbeddings`Private`w, 1990, True], 
       DiachronicEmbeddings`deTrajectoryPlot[
         Pattern[DiachronicEmbeddings`Private`w, 
          Blank[String]], 
         Pattern[DiachronicEmbeddings`Private`yearMax, 
          Blank[]]] := 
       DiachronicEmbeddings`deTrajectoryPlot[
        DiachronicEmbeddings`Private`w, DiachronicEmbeddings`Private`yearMax, 
         True], DiachronicEmbeddings`deTrajectoryPlot[
         Pattern[DiachronicEmbeddings`Private`w, 
          Blank[String]], 
         Pattern[DiachronicEmbeddings`Private`yearMax, 
          Blank[]], 
         Pattern[DiachronicEmbeddings`Private`showLabels, 
          Blank[]]] := 
       Module[{DiachronicEmbeddings`Private`r = 
          DiachronicEmbeddings`Private`trajRec[
           DiachronicEmbeddings`Private`w], DiachronicEmbeddings`Private`ds, 
          DiachronicEmbeddings`Private`path, 
          DiachronicEmbeddings`Private`nbrs, DiachronicEmbeddings`Private`n, 
          DiachronicEmbeddings`Private`shown, 
          DiachronicEmbeddings`Private`last}, 
         DiachronicEmbeddings`Private`ds = 
          DiachronicEmbeddings`Private`r["decades"]; 
         DiachronicEmbeddings`Private`path = 
          DiachronicEmbeddings`Private`r["path"]; 
         DiachronicEmbeddings`Private`nbrs = 
          DiachronicEmbeddings`Private`r["neighbors"]; 
         DiachronicEmbeddings`Private`n = 
          Length[DiachronicEmbeddings`Private`ds]; 
         DiachronicEmbeddings`Private`shown = Select[
            Range[DiachronicEmbeddings`Private`n], ToExpression[
              Part[DiachronicEmbeddings`Private`ds, #]] <= 
            DiachronicEmbeddings`Private`yearMax& ]; Graphics[{
            Map[DiachronicEmbeddings`Private`nbMark[
              Part[#, 2]]& , DiachronicEmbeddings`Private`nbrs], 
            If[DiachronicEmbeddings`Private`showLabels, 
             Map[DiachronicEmbeddings`Private`nbLabel[
               Part[#, 1], 
               Part[#, 2]]& , DiachronicEmbeddings`Private`nbrs], {}], 
            If[Length[DiachronicEmbeddings`Private`shown] >= 2, 
             Table[{
               DiachronicEmbeddings`Private`deCol[
                DiachronicEmbeddings`Private`frac[
                 Part[
                 DiachronicEmbeddings`Private`ds, 
                  DiachronicEmbeddings`Private`i]]], 
               Opacity[0.5], 
               Thickness[0.006], 
               Line[{
                 Part[
                 DiachronicEmbeddings`Private`path, 
                  DiachronicEmbeddings`Private`i], 
                 Part[
                 DiachronicEmbeddings`Private`path, 
                  DiachronicEmbeddings`Private`i + 1]}]}, {
              DiachronicEmbeddings`Private`i, 
               Most[DiachronicEmbeddings`Private`shown]}], {}], 
            Opacity[1], 
            Table[{
              DiachronicEmbeddings`Private`deCol[
               DiachronicEmbeddings`Private`frac[
                Part[
                DiachronicEmbeddings`Private`ds, 
                 DiachronicEmbeddings`Private`i]]], 
              EdgeForm[White], 
              PointSize[0.022], 
              Point[
               Part[
               DiachronicEmbeddings`Private`path, 
                DiachronicEmbeddings`Private`i]]}, {
             DiachronicEmbeddings`Private`i, 
              DiachronicEmbeddings`Private`shown}], 
            If[
            DiachronicEmbeddings`Private`shown =!= {}, 
             DiachronicEmbeddings`Private`last = 
              Last[DiachronicEmbeddings`Private`shown]; {
               Text[
                Style[
                 DiachronicEmbeddings`Private`decLabel[
                  Part[DiachronicEmbeddings`Private`ds, 1]], Bold, 11, 
                 DiachronicEmbeddings`Private`deCol[
                  DiachronicEmbeddings`Private`frac[
                   Part[DiachronicEmbeddings`Private`ds, 1]]]], 
                Part[DiachronicEmbeddings`Private`path, 1], {0, -1.7}], 
               Text[
                Style[
                 DiachronicEmbeddings`Private`decLabel[
                  Part[
                  DiachronicEmbeddings`Private`ds, 
                   DiachronicEmbeddings`Private`last]], Bold, 13, 
                 DiachronicEmbeddings`Private`deCol[
                  DiachronicEmbeddings`Private`frac[
                   Part[
                   DiachronicEmbeddings`Private`ds, 
                    DiachronicEmbeddings`Private`last]]]], 
                Part[
                DiachronicEmbeddings`Private`path, 
                 DiachronicEmbeddings`Private`last], {0, -1.7}]}, {}]}, 
           PlotLabel -> 
           Style["\"" <> DiachronicEmbeddings`Private`w <> "\"", 16, Bold, 
             FontFamily -> "Helvetica"], PlotRange -> CoordinateBounds[
             Join[DiachronicEmbeddings`Private`path, 
              Part[DiachronicEmbeddings`Private`nbrs, All, 2]], 
             Scaled[0.12]], ImageSize -> 560, AspectRatio -> 0.85, Background -> 
           White]], 
