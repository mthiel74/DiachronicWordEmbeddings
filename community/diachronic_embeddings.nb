Cell[TextData[{
 "A few worth visiting: ",
 StyleBox["broadcast",
  FontSlant->Italic],
 " (agricultural ",
 StyleBox["sow / seed / scatter",
  FontSlant->Italic],
 " \[Rule] ",
 StyleBox["radio / television / bbc",
  FontSlant->Italic],
 "); ",
 StyleBox["computer",
  FontSlant->Italic],
 " (a V from human surnames through ",
 StyleBox["electronic / circuits",
  FontSlant->Italic],
 " to ",
 StyleBox["software / internet",
  FontSlant->Italic],
 "); ",
 StyleBox["mouse",
  FontSlant->Italic],
 " (keeps ",
 StyleBox["rat / cat",
  FontSlant->Italic],
 " but grows a second ",
 StyleBox["cursor / click / keyboard",
  FontSlant->Italic],
 " cluster); ",
 StyleBox["web",
  FontSlant->Italic],
 " (spider \[Rule] ",
 StyleBox["www / browser / server",
  FontSlant->Italic],
 "); ",
 StyleBox["terrific",
  FontSlant->Italic],
 " and ",
 StyleBox["awful",
  FontSlant->Italic],
 " (the two halves of a terror-to-praise swap); and ",
 StyleBox["guy",
  FontSlant->Italic],
 " (the Guy Fawkes effigy \[Rule] ",
 StyleBox["fellow / chap / dude",
  FontSlant->Italic],
 ")."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"6a731d7c-1497-43c8-8354-57be2c526772"],

Cell[TextData[{
 "Not every famous case shows up cleanly, and the explorer is honest about ",
 "that. ",
 StyleBox["literally",
  FontSlant->Italic],
 " is the textbook example of a meaning change \[Dash] the ",
 "modern hyperbolic intensifier \[Dash] yet in this corpus its neighbours \
stay anchored ",
 "to ",
 StyleBox["literal, figuratively, metaphorically",
  FontSlant->Italic],
 " across all twenty decades, with ",
 "only a faint late drift toward ",
 StyleBox["thousands, hundreds, utterly",
  FontSlant->Italic],
 ". The intensifier sense is mostly a spoken-register phenomenon that the \
edited-book ",
 "Google N-grams corpus barely records, so the embedding has little to latch \
onto. A ",
 "real reminder that ",
 StyleBox["absence of measured drift is not absence of change",
  FontWeight->Bold],
 " \[Dash] only absence of evidence ",
 StyleBox["in this corpus",
  FontSlant->Italic],
 "."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"2d716ec3-b21f-4d1c-925a-cd34164374a9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Nearest-neighbour drift tables", "Section",ExpressionUUID->"7492b85d-81a5-4c04-ab54-9901a5ecd44e"],

Cell["\<\
The trajectories are the geometry of a simpler fact: the list of a word's \
nearest neighbours turns over from decade to decade. Neighbours are computed \
by cosine similarity in each decade's own native space. Sampled every fifty \
years:\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"77112208-8222-4b77-be6a-1abddc45fa4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"deNeighborTable", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<gay\>\"", ",", "\"\<broadcast\>\"", ",", "\"\<awful\>\"", 
    ",", "\"\<computer\>\"", ",", "\"\<guy\>\"", ",", "\"\<terrific\>\"", 
    ",", "\"\<media\>\"", ",", "\"\<queer\>\""}], "}"}], "]"}]], "Input",
 CellMargins->{{50, 30}, {8, 8}},
 FontSize->12,ExpressionUUID->"351ed9e8-beca-4cae-8826-a26f3c14fe15"],

