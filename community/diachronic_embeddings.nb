Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 "The 25 most-drifted stable content words, 1800s\[Dash]1990s. Full ",
 "ranking in ",
 StyleBox["data/drift_ranking.json",
  FontFamily->"Courier"],
 "."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"22d608d2-1020-43ff-86ed-ad34aa5271c7"],

Cell[TextData[{
 StyleBox["Takeaway.  ",
  FontWeight->Bold],
 "Embeddings are a powerful detector of ",
 StyleBox["that",
  FontSlant->Italic],
 " something changed about a word's usage; deciding ",
 StyleBox["what",
  FontSlant->Italic],
 " changed still needs the neighbour lists, the trajectories, and human \
judgement."
}], "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellMargins->{{60, 60}, {8, 12}},
 CellFrameColor->RGBColor[0.35, 0.6, 0.4],
 FontSize->12,
 Background->RGBColor[
  0.93, 0.97, 0.93],ExpressionUUID->"fefb1941-3e6b-4d82-9572-0bf50ea19da5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Methods and reproduction", "Section",ExpressionUUID->"090958e8-cc2e-4bcb-a32c-c8a1fa26a8cf"],

Cell["\<\
The science is pure Wolfram Language; the only Python is a format shim for \
the NumPy/pickle files. Five steps:\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"7544a131-b99f-471f-9248-15794f08ea9a"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/fetch_data.wls",
  FontFamily->"Courier"],
 "  \[Dash] download + unzip the HistWords eng-all SGNS embeddings"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"01dfc192-f918-49be-b1d3-3f38439bd7bc"],

Cell[TextData[{
 StyleBox["python3 src/convert_histwords.py",
  FontFamily->"Courier"],
 "  \[Dash] .npy/.pkl \[Rule] float32 binaries + vocab (anchors, targets, \
pools)"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"0faa5a5f-1915-406b-955d-08cd01008b26"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/trajectories.wls",
  FontFamily->"Courier"],
 "  \[Dash] Procrustes alignment, projection, the trajectory figures + JSON"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"c0e1ea42-5ab0-406f-849e-aeb429f9ab59"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/laws_and_drift.wls",
  FontFamily->"Courier"],
 "  \[Dash] drift leaderboard + the two statistical laws"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"306a1644-5720-44e6-973a-0429ea83ba57"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/alignment.wls",
  FontFamily->"Courier"],
 " and ",
 StyleBox["wolfram/hero.wls",
  FontFamily->"Courier"],
 "  \[Dash] the alignment diagnostic and the cover animation"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"7c103dd9-15a4-4bee-84f3-48e52986794a"],

Cell[TextData[{
 "Repository: ",
 StyleBox["github.com/mthiel74/DiachronicWordEmbeddings",
  FontFamily->"Courier"],
 ". Derived products (neighbour tables, trajectory coordinates, alignment \
diagnostics, ",
 "drift ranking) are committed as small JSON files; the 1.6 GB raw download \
is ",
 "regenerable. The interactive explorer in \[Section]5 embeds its 2-D \
coordinates, so ",
 "the notebook is self-contained."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"fc914ce6-f2cc-4c72-8e52-11a8d51a812a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. References", "Section",ExpressionUUID->"73692324-f8f1-45e8-ab2e-c2b1f9360405"],

Cell[TextData[{
 "W. L. Hamilton, J. Leskovec, D. Jurafsky (2016). ",
 StyleBox["Diachronic Word Embeddings Reveal Statistical Laws of Semantic \
Change.",
  FontSlant->Italic],
 " ACL 2016. arXiv:1605.09096."
}], "Text",
 CellMargins->{{60, 50}, {3, 3}},
 FontSize->11,ExpressionUUID->"ff443e87-190d-4682-873a-e1ba1dc3b5bc"],

Cell["\<\
HistWords project and data: https://nlp.stanford.edu/projects/histwords/ \
(Stanford NLP).\
\>", "Text",
 CellMargins->{{60, 50}, {3, 3}},
 FontSize->11,ExpressionUUID->"8ac8994e-04a1-42dd-b015-5b6e09806f6f"]
}, Open  ]]
}, Open  ]]
