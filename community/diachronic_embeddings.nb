Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 "Rate of semantic change vs. number of WordNet senses; red markers are ",
 "per-sense-count means."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"b795d36a-fea5-4f18-9601-0c09fa4c09b4"],

Cell["\<\
The effects are modest with a rank-based frequency proxy on a single corpus, \
but both reproduce the published direction.\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"37ff93f0-904c-46bb-a8c6-9c10a221c2c8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. The most-drifted words \[Dash] and a caveat", "Section",ExpressionUUID->"56f1fa08-cfbd-4ab6-8056-25767eb60ba4"],

Cell[TextData[{
 "Ranking every stable content word by how far it moved between its 1800s ",
 "and 1990s aligned vectors surfaces two phenomena at once. Some entries are \
genuine ",
 "meaning change (",
 StyleBox["advert",
  FontSlant->Italic],
 " verb \[Rule] noun, ",
 StyleBox["peer",
  FontSlant->Italic],
 " noble \[Rule] equal, ",
 StyleBox["media",
  FontSlant->Italic],
 ", ",
 StyleBox["broadcast",
  FontSlant->Italic],
 "); others are lexical obsolescence or register shift, where an archaic word \
(",
 StyleBox["twelvemonth, fourthly, civilities",
  FontSlant->Italic],
 ") simply stopped appearing in the same kinds of text. A large embedding ",
 "displacement means \[OpenCurlyDoubleQuote]the contexts changed\
\[CloseCurlyDoubleQuote], ",
 "which is necessary but not sufficient for \[OpenCurlyDoubleQuote]the \
meaning ",
 "changed\[CloseCurlyDoubleQuote]."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"465563e2-f902-418e-9b0f-539a7982ca8c"],

