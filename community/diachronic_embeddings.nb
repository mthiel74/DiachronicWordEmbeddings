>      deWords = 
 
>       {gay, broadcast, computer, awful, queer, literally, terrific, guy, 
 
>        media, fun, cell, nice, mouse, web}; 
 
>      deCol[t_] := 
 
>       Blend[{RGBColor[0.13, 0.34, 0.68], RGBColor[0.85, 0.16, 0.11]}, t]; 
 
>      deDraw[w_, yearMax_, showLabels_] := 
 
>       Module[{r = deData[w], ds, path, nbrs, n, fr, shown, last}, 
 
>        ds = r[decades]; path = r[path]; nbrs = r[neighbors]; 
 
                                    ToExpression[ds[[i]]] - 1800
>         n = Length[ds]; fr[i_] := ----------------------------; 
                                                190.
 
>         shown = Select[Range[n], ToExpression[ds[[#1]]] <= yearMax & ]; 
 
>         -Graphics-]; )]\
\>"], "Output",
