Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 StyleBox["broadcast",
  FontSlant->Italic],
 " begins as an agricultural term among ",
 StyleBox["sow, seed, scatter, cuttings",
  FontSlant->Italic],
 " and moves wholesale into ",
 StyleBox["radio, television, bbc, broadcasting",
  FontSlant->Italic],
 " \[Dash] the word the new technology ",
 "borrowed."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
