Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 "Rate of semantic change vs. frequency (\[Minus]log mean rank). Red ",
 "markers are decile means; the trend is the per-word regression."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"ee7e77db-320c-414a-8786-a3049823a3e8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The law of innovation", "Subsection",ExpressionUUID->"2639581d-646f-4df1-8021-42853b22233a"],

Cell[TextData[{
 StyleBox["More polysemous words change faster.",
  FontWeight->Bold],
 " Using each word's number of ",
 "WordNet senses (from the Wolfram Language ",
 StyleBox["WordData",
  FontFamily->"Courier"],
 " knowledgebase) as a ",
 "polysemy measure, change-rate rises with polysemy (Spearman \[Rho] \
\[TildeTilde] ",
 "0.20). ",
 StyleBox["Why:",
  FontSlant->Italic],
 " a word that already spans several senses sits near several ",
 "neighbourhoods at once, giving any new usage more directions in which to \
pull it."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"acb345ab-acae-412d-ac87-ec092665e9c1"],

