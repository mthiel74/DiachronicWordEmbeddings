$CellContext`deWords = {
        "gay", "broadcast", "computer", "awful", "queer", "literally", 
         "terrific", "guy", "media", "fun", "cell", "nice", "mouse", 
         "web"}; $CellContext`deCol[
         Pattern[$CellContext`t, 
          Blank[]]] := Blend[{
          RGBColor[0.13, 0.34, 0.68], 
          RGBColor[0.85, 0.16, 0.11]}, $CellContext`t]; $CellContext`deDraw[
         Pattern[$CellContext`w, 
          Blank[]], 
         Pattern[$CellContext`yearMax, 
          Blank[]], 
         Pattern[$CellContext`showLabels, 
          Blank[]]] := 
       Module[{$CellContext`r = $CellContext`deData[$CellContext`w], \
$CellContext`ds, $CellContext`path, $CellContext`nbrs, $CellContext`n, \
$CellContext`fr, $CellContext`shown, $CellContext`last}, $CellContext`ds = \
$CellContext`r["decades"]; $CellContext`path = $CellContext`r[
           "path"]; $CellContext`nbrs = $CellContext`r[
           "neighbors"]; $CellContext`n = 
          Length[$CellContext`ds]; $CellContext`fr[
            Pattern[$CellContext`i, 
             Blank[]]] := (ToExpression[
              Part[$CellContext`ds, $CellContext`i]] - 1800)/
           190.; $CellContext`shown = Select[
            Range[$CellContext`n], ToExpression[
              Part[$CellContext`ds, #]] <= $CellContext`yearMax& ]; 
         Graphics[{
            If[$CellContext`showLabels, {
              GrayLevel[0.5], 
              Map[Text[
                Style[
                 Part[#, 1], Italic, 10], 
                Part[#, 2]]& , $CellContext`nbrs]}, {}], 
            If[Length[$CellContext`shown] >= 2, 
             Table[{
               $CellContext`deCol[
                $CellContext`fr[$CellContext`i]], 
               Opacity[0.5], 
               Thickness[0.006], 
               Line[{
                 Part[$CellContext`path, $CellContext`i], 
                 
                 Part[$CellContext`path, $CellContext`i + 
                  1]}]}, {$CellContext`i, 
               Most[$CellContext`shown]}], {}], 
            Opacity[1], 
            Table[{
              $CellContext`deCol[
               $CellContext`fr[$CellContext`i]], 
              EdgeForm[White], 
              PointSize[0.022], 
              Point[
               
               Part[$CellContext`path, $CellContext`i]]}, {$CellContext`i, \
$CellContext`shown}], 
            
            If[$CellContext`shown =!= {}, $CellContext`last = 
              Last[$CellContext`shown]; {
               Text[
                Style[StringTake[
                   Part[$CellContext`ds, 1], -2] <> "s", Bold, 11, 
                 $CellContext`deCol[
                  $CellContext`fr[1]]], 
                Part[$CellContext`path, 1], {0, -1.7}], 
               Text[
                Style[StringTake[
                   Part[$CellContext`ds, $CellContext`last], -2] <> "s", Bold,
                  13, 
                 $CellContext`deCol[
                  $CellContext`fr[$CellContext`last]]], 
                Part[$CellContext`path, $CellContext`last], {0, -1.7}]}, {}]},
            PlotLabel -> 
           Style[$CellContext`w, 16, Bold, FontFamily -> "Helvetica"], 
           PlotRange -> CoordinateBounds[
             Join[$CellContext`path, 
              Part[$CellContext`nbrs, All, 2]], 
             Scaled[0.12]], ImageSize -> 560, AspectRatio -> 0.85, Background -> 
           White]]; Null); Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Input",
 CellMargins->{{50, 30}, {6, 6}},
 FontSize->11,
 CellLabel->" In[1]:=",ExpressionUUID->"aecf9a09-586c-482f-b451-088438bbbc8d"],

