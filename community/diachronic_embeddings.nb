Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 "The 25 most-drifted stable content words, 1800s\[Dash]1990s. Full ",
 "ranking in ",
 StyleBox["data/drift_ranking.json",
  FontFamily->"Courier"],
 "."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"efe0db79-be54-425a-8cc0-c872e9f644bc"],

Cell[TextData[{
 StyleBox["Takeaway.  ",
  FontWeight->Bold],
 "Embeddings are a powerful detector of ",
 StyleBox["that",
  FontSlant->Italic],
 " something changed about a word's usage; deciding ",
 StyleBox["what",
  FontSlant->Italic],
 " changed still needs the neighbour lists, the trajectories, and human \
judgement."
}], "Text",
 CellFrame->{{3, 0}, {0, 0}},
 CellMargins->{{60, 60}, {8, 12}},
 CellFrameColor->RGBColor[0.35, 0.6, 0.4],
 FontSize->12,
 Background->RGBColor[
  0.93, 0.97, 0.93],ExpressionUUID->"ae10966a-c60a-4e04-a806-125dc99b6f39"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Methods and reproduction", "Section",ExpressionUUID->"15302dcc-4550-4ec1-9771-528db86131ca"],

Cell["\<\
The science is pure Wolfram Language; the only Python is a format shim for \
the NumPy/pickle files. Five steps:\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"757c1ca9-5751-4da4-8f7e-d9c6a388110d"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/fetch_data.wls",
  FontFamily->"Courier"],
 "  \[Dash] download + unzip the HistWords eng-all SGNS embeddings"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"3c3284f5-61cf-4dab-806c-5537af566abe"],

Cell[TextData[{
 StyleBox["python3 src/convert_histwords.py",
  FontFamily->"Courier"],
 "  \[Dash] .npy/.pkl \[Rule] float32 binaries + vocab (anchors, targets, \
pools)"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"4b6f4b18-57a6-4191-97ef-fa6a04580ee7"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/trajectories.wls",
  FontFamily->"Courier"],
 "  \[Dash] Procrustes alignment, projection, the trajectory figures + JSON"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"cb8e2f28-a40a-4a81-95e8-d3b31d9bdf90"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/laws_and_drift.wls",
  FontFamily->"Courier"],
 "  \[Dash] drift leaderboard + the two statistical laws"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"1361358e-0e93-4b9f-bb54-e54c57256aac"],

Cell[TextData[{
 StyleBox["wolframscript -file wolfram/alignment.wls",
  FontFamily->"Courier"],
 " and ",
 StyleBox["wolfram/hero.wls",
  FontFamily->"Courier"],
 "  \[Dash] the alignment diagnostic and the cover animation"
}], "Item",
 CellMargins->{{66, 50}, {3, 
  3}},ExpressionUUID->"b68257b0-acd1-44bf-99f6-ee453cdef24d"],

Cell[TextData[{
 "Repository: ",
 StyleBox["github.com/mthiel74/DiachronicWordEmbeddings",
  FontFamily->"Courier"],
 ". Derived products (neighbour tables, trajectory coordinates, alignment \
diagnostics, ",
 "drift ranking) are committed as small JSON files; the 1.6 GB raw download \
is ",
 "regenerable. The interactive explorer in \[Section]5 embeds its 2-D \
coordinates, so ",
 "the notebook is self-contained."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"836c81cc-392d-4fc2-9a76-9222fe6ea286"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. References", "Section",ExpressionUUID->"59b5eb37-c9a9-43fb-b105-10936874caac"],

Cell[TextData[{
 "W. L. Hamilton, J. Leskovec, D. Jurafsky (2016). ",
 StyleBox["Diachronic Word Embeddings Reveal Statistical Laws of Semantic \
Change.",
  FontSlant->Italic],
 " ACL 2016. arXiv:1605.09096."
}], "Text",
 CellMargins->{{60, 50}, {3, 3}},
 FontSize->11,ExpressionUUID->"16eeac34-f009-473c-a605-c5db8e8e8833"]
}, Open  ]]
}, Open  ]]
