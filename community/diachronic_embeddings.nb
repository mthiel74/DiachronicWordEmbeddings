Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 StyleBox["computer",
  FontSlant->Italic],
 " traces a V: from human ",
 "\[OpenCurlyDoubleQuote]computers\[CloseCurlyDoubleQuote] (surnames such as ",
 StyleBox["williams, barney, burt",
  FontSlant->Italic],
 ") at 1900, down through ",
 StyleBox["electronic, circuits, digital",
  FontSlant->Italic],
 " mid-century, up to ",
 StyleBox["software, internet, database",
  FontSlant->Italic],
 ". The dashed leg is the 1900\[Dash]1940 gap."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"0786c870-4a48-4b49-81a2-1255940e7061"],

