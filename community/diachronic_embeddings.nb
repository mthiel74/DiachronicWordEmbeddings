Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 StyleBox["terrific",
  FontSlant->Italic],
 " ameliorates from ",
 StyleBox["dreadful, terrible, fearful",
  FontSlant->Italic],
 " to ",
 StyleBox["marvelous, wonderful, splendid",
  FontSlant->Italic],
 " \[Dash] the same terror-to-praise path ",
 StyleBox["awful",
  FontSlant->Italic],
 " took in reverse."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"71395806-7ec1-48a1-aeb1-e626e8525c68"],

