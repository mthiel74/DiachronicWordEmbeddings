Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 "Rate of semantic change vs. frequency. Red markers are decile means."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
  16}},ExpressionUUID->"0052f651-d10b-4565-86ba-cf503beeb235"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The law of innovation", "Subsection",ExpressionUUID->"8fee59bc-0b65-47dc-a044-b7549e5a9360"],

Cell[TextData[{
 StyleBox["Polysemous words change faster.",
  FontWeight->Bold],
 " Using each word's number of ",
 "WordNet senses (from the Wolfram Language ",
 StyleBox["WordData",
  FontFamily->"Courier"],
 " knowledgebase) as a polysemy measure, the rate of change rises with \
polysemy ",
 "(Spearman \[Rho] \[TildeTilde] 0.20): words that already carry many senses \
are the ",
 "ones most apt to acquire another."
}], "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"767b4ec6-3b3c-4378-9a12-19110f9fa9bf"],

