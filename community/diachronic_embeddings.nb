Cell[TextData[{
 StyleBox["Figure. ",
  FontWeight->Bold],
 StyleBox["gay",
  FontSlant->Italic],
 " lingers among ",
 StyleBox["merry, cheerful, lively, joyous",
  FontSlant->Italic],
 " through the early-20th-century before swinging sharply toward ",
 StyleBox["homosexual, lesbian, gays",
  FontSlant->Italic],
 " in the final decades."
}], "Caption",
 CellMargins->{{55, 55}, {2, 
