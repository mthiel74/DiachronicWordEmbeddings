m9DdWE05GahRoZSilQRhX6ScabsEGM8zmlOHAdC0Jb5aHafBW3T5guiSrQhaZofGIat4Fn2bAnNwXo\
ZOCcCcjFSGL+a41wMVugPndgN/QNVaZ/O5m6SsG6pZ06+aqERP+sImf1T5fwFKq+rU\"];
wordList = {\"gay\", \"broadcast\", \"computer\", \"awful\", \"queer\", \
\"literally\", \"terrific\", \"guy\", \"media\", \"fun\", \"cell\", \"nice\", \
\"mouse\", \"web\"};

timeColor[t_] := Blend[{RGBColor[0.13, 0.34, 0.68], RGBColor[0.85, 0.16, \
0.11]}, t];

drawWord[w_, yearMax_, showLabels_] := Module[
   {r = trajData[w], ds, path, nbrs, n, fr, shown, last},
   ds = r[\"decades\"]; path = r[\"path\"]; nbrs = r[\"neighbors\"]; n = \
Length[ds];
   fr[i_] := (ToExpression[ds[[i]]] - 1800)/190.;
   shown = Select[Range[n], ToExpression[ds[[#]]] <= yearMax &];
   Graphics[{
      If[showLabels, {GrayLevel[0.5],
         (Text[Style[#[[1]], Italic, 10], #[[2]]] & /@ nbrs)}, {}],
      If[Length[shown] >= 2, Table[{timeColor[fr[i]], Opacity[0.5], \
Thickness[0.006],
         Line[{path[[i]], path[[i + 1]]}]}, {i, Most[shown]}], {}], Opacity[1],
      Table[{timeColor[fr[i]], EdgeForm[White], PointSize[0.022], \
Point[path[[i]]]},
         {i, shown}],
      If[shown =!= {}, last = Last[shown];
         {Text[Style[StringTake[ds[[1]], -2] <> \"s\", Bold, 11, \
timeColor[fr[1]]],
            path[[1]], {0, -1.7}],
          Text[Style[StringTake[ds[[last]], -2] <> \"s\", Bold, 13, \
timeColor[fr[last]]],
            path[[last]], {0, -1.7}]}, {}]},
    PlotLabel -> Style[w, 16, Bold, FontFamily -> \"Helvetica\"],
    PlotRange -> CoordinateBounds[Join[path, nbrs[[All, 2]]], Scaled[0.12]],
    ImageSize -> 560, AspectRatio -> 0.85, Background -> White]];\
\>", "Input",
 CellMargins->{{50, 30}, {6, 6}},
 FontSize->10,
 CellLabel->" In[1]:=",ExpressionUUID->"32538dcd-5e58-4b3a-9f7e-594424339baa"],

Cell[CellGroupData[{

Cell["\<\
Manipulate[
  drawWord[word, yearMax, neighbourLabels],
  {{word, \"gay\", \"word\"}, wordList},
  {{yearMax, 1990, \"reveal decades up to\"}, 1800, 1990, 10, Appearance -> \
\"Labeled\"},
  {{neighbourLabels, True, \"neighbour labels\"}, {True, False}},
  ControlPlacement -> Top, SaveDefinitions -> True]\
\>", "Input",
 CellMargins->{{50, 30}, {6, 6}},
 FontSize->11,
 CellLabel->" In[8]:=",ExpressionUUID->"2c3c4d94-ea46-45a7-bc62-299e2b85812a"],

Cell[OutputFormData["\<\
Manipulate[drawWord[word, yearMax, neighbourLabels], 
 
>   {{word, gay, word}, {gay, broadcast, computer, awful, queer, literally, 
 
>     terrific, guy, media, fun, cell, nice, mouse, web}}, 
 
>   {{yearMax, 1990, reveal decades up to}, 1800, 1990, 10, 
 
>    Appearance -> Labeled}, {{neighbourLabels, True, neighbour labels}, 
 
>    {True, False}}, ControlPlacement -> Top, SaveDefinitions -> True]\
\>"], "Output",
 CellChangeTimes->{3.989118038160967*^9},
 CellLabel->" Out[8]=",ExpressionUUID->"f47649fd-a64c-4e8e-b6ca-831537afc8e2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Nearest-neighbour drift tables", "Section",ExpressionUUID->"b7fad0e4-bf6f-49fa-a3ce-3eabbe099fd3"],

Cell["\<\
The trajectories are the geometry of a simpler fact: the list of a word's \
nearest neighbours turns over from decade to decade. Neighbours are computed \
by cosine similarity in each decade's own native space. Sampled every fifty \
years:\
\>", "Text",
 CellMargins->{{50, 50}, {6, 
  6}},ExpressionUUID->"25226856-72d6-48da-99cc-d48c61c274fc"],

